__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/
dist-standalone/
.venv/

# Levels built from a user's own game files, and the game's own files, never belong here.
*.glb
*.gltf
*.toc
*.sb
*.cas
*.cat
*.dds
*.png
*.jpg
*.jpeg
*.bin
*.zip
*.7z
.claude/
*.jsonl
*.log

# Oodle belongs to the game that ships it; it is never part of this repository.
*.dll
*.exe
# the window's own images (logo, icons): ours, not game data
!*/app/assets/*.png
!docs/assets/tool-64.png
!docs/assets/favicon.ico
